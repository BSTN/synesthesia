DirectoryIndex index.php
Options -Indexes -MultiViews

RewriteEngine On

# Never serve implementation/config/dependency files directly.
RewriteRule ^(?:config\.php|router\.php|composer\.(?:json|lock)|setup/|vendor/) - [F,L]

# Let real public assets pass through.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route SPA pages and top-level operational aliases through PHP.
RewriteRule ^ index.php [L]
